rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownerExists() { return exists(/databases/$(database)/documents/meta/owner); }
    function isOwner() {
      return signedIn() && ownerExists()
        && get(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid;
    }
    function hasRole() {
      return signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid));
    }
    function myRole() { return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data; }
    function activeRole(r) { return hasRole() && myRole().role == r && myRole().get('active', true) != false; }
    function isAcc() { return activeRole('accountant'); }
    function isField() { return activeRole('field'); }
    function isEng() { return activeRole('engineer'); }
    function isMgr() { return isOwner() || isAcc(); }
    function isMember() { return isOwner() || isAcc() || isField() || isEng(); }
    // a pending owner change (chg/{id}) that the accountant is applying to this exact path
    function chgFor(p) {
      return request.resource.data.get('chg', '') != ''
        && exists(/databases/$(database)/documents/chg/$(request.resource.data.chg))
        && get(/databases/$(database)/documents/chg/$(request.resource.data.chg)).data.status == 'pending'
        && get(/databases/$(database)/documents/chg/$(request.resource.data.chg)).data.path == p;
    }
    // fields the owner may change directly on a day: closing / approving / ratings / work type (no money)
    function ownerFree() {
      return ['date', 'evl', 'wtc', 'status', 'approved', 'approvedAt', 'approvedBy', 'closedAt', 'closedBy', 'log', 'updatedAt', 'updatedBy'];
    }
    function dayClosed(d) {
      return exists(/databases/$(database)/documents/dstat/$(d))
        && get(/databases/$(database)/documents/dstat/$(d)).data.status == 'closed';
    }

    // owner record: readable before login (to know whether setup is needed); created once
    match /meta/owner {
      allow read: if true;
      allow create: if signedIn() && !ownerExists() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // username -> login email map (no secrets inside)
    match /logins/{name} {
      allow read: if true;
      allow write: if isOwner();
    }
    // per-user role, permissions, and the limited list of items a field user may see
    match /roles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow write: if isOwner();
    }
    // accountant may only ADD suppliers / equipment: existing entries must stay unchanged
    function keeps(k) { return request.resource.data.get(k, []).hasAll(resource.data.get(k, [])); }
    match /master/{id} {
      allow read: if isMgr() || isEng();
      allow write: if isOwner();
      allow update: if isAcc()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suppliers', 'hourly', 'monthly', 'trucks', 'items'])
        && keeps('suppliers') && keeps('hourly') && keeps('monthly') && keeps('trucks') && keeps('items');
    }
    match /days/{d} {
      allow read: if isMgr() || isEng();
      // the owner never writes numbers directly: only close / reopen / approve / ratings / work type.
      // any change in the numbers goes to /chg and is applied by the accountant after his approval
      allow create: if isOwner() && request.resource.data.keys().hasOnly(ownerFree());
      allow update: if isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerFree());
      // accountant enters and edits an open day (and closes it)
      allow create: if isAcc() && request.resource.data.get('approved', false) == false;
      allow update: if isAcc() && resource.data.get('status', 'open') != 'closed'
        && request.resource.data.get('approved', false) == false;
      // accountant applies an owner change he approved (also on a closed day); approval is reset
      allow create, update: if isAcc() && chgFor('days/' + d) && request.resource.data.get('approved', false) == false;
    }
    match /dstat/{d} {
      allow read: if isMember();
      allow write: if isOwner() || isAcc();
    }
    match /entries/{id} {
      allow read: if isMgr() || isEng() || (signedIn() && resource.data.by == request.auth.uid);
      // owner may only reopen a supervisor hand-in
      allow update: if isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sub', 'subAt']);
      // accountant corrects supervisor entries of an open day
      allow update: if isAcc() && !dayClosed(resource.data.date)
        && request.resource.data.by == resource.data.by && request.resource.data.date == resource.data.date;
      allow create, update: if isAcc() && chgFor('entries/' + id);
      allow create, update: if (isAcc() || isField())
        && request.resource.data.by == request.auth.uid
        && id == request.resource.data.date + '_' + request.auth.uid
        && (resource == null || resource.data.by == request.auth.uid)
        // after a supervisor hands in (sub = true) only the owner can reopen it
        && (resource == null || resource.data.get('sub', false) == false)
        && !dayClosed(request.resource.data.date);
    }
    // production parts (cut / fill layers by chainage): engineer records, owner and accountant view
    match /prod/{id} {
      allow read: if isMgr() || isEng();
      allow write: if isOwner() || isEng();
    }
    // owner change requests: the owner proposes, only the accountant approves or rejects
    match /chg/{id} {
      allow read: if isMgr();
      allow create: if isOwner() && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAcc() && resource.data.status == 'pending'
        && request.resource.data.status in ['ok', 'no']
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt', 'dnote']);
      allow update: if isOwner() && resource.data.by == request.auth.uid && resource.data.status == 'pending'
        && request.resource.data.status == 'cancel'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt']);
    }
    match /sealed/{d} {
      allow read: if isMgr();
      allow write: if isOwner();
    }
    match /requests/{id} {
      allow read: if isOwner() || (signedIn() && resource.data.by == request.auth.uid);
      allow create: if isMember() && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isOwner();
    }
  }
}
