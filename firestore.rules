rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownerExists() { return exists(/databases/$(database)/documents/meta/owner); }
    function isOwner() {
      return signedIn() && ownerExists()
        && get(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid;
    }
    function hasRole() {
      return signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid));
    }
    function myRole() { return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data; }
    function activeRole(r) { return hasRole() && myRole().role == r && myRole().get('active', true) != false; }
    function isAcc() { return activeRole('accountant'); }
    function isField() { return activeRole('field'); }
    function isEng() { return activeRole('engineer'); }
    function isMgr() { return isOwner() || isAcc(); }
    function isMember() { return isOwner() || isAcc() || isField() || isEng(); }
    function dayClosed(d) {
      return exists(/databases/$(database)/documents/dstat/$(d))
        && get(/databases/$(database)/documents/dstat/$(d)).data.status == 'closed';
    }

    // owner record: readable before login (to know whether setup is needed); created once
    match /meta/owner {
      allow read: if true;
      allow create: if signedIn() && !ownerExists() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // username -> login email map (no secrets inside)
    match /logins/{name} {
      allow read: if true;
      allow write: if isOwner();
    }
    // per-user role, permissions, and the limited list of items a field user may see
    match /roles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow write: if isOwner();
    }
    // accountant may only ADD suppliers / equipment: existing entries must stay unchanged
    function keeps(k) { return request.resource.data.get(k, []).hasAll(resource.data.get(k, [])); }
    match /master/{id} {
      allow read: if isMgr() || isEng();
      allow write: if isOwner();
      allow update: if isAcc()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suppliers', 'hourly', 'monthly', 'trucks', 'items'])
        && keeps('suppliers') && keeps('hourly') && keeps('monthly') && keeps('trucks') && keeps('items');
    }
    match /days/{d} {
      allow read: if isMgr() || isEng();
      allow write: if isOwner();
      // accountant enters and edits an open day (and closes it); a closed day changes only with the owner
      allow create: if isAcc() && request.resource.data.get('approved', false) == false;
      allow update: if isAcc() && resource.data.get('status', 'open') != 'closed'
        && request.resource.data.get('approved', false) == false;
    }
    match /dstat/{d} {
      allow read: if isMember();
      allow write: if isOwner() || isAcc();
    }
    match /entries/{id} {
      allow read: if isMgr() || isEng() || (signedIn() && resource.data.by == request.auth.uid);
      allow write: if isOwner();
      allow create, update: if (isAcc() || isField())
        && request.resource.data.by == request.auth.uid
        && id == request.resource.data.date + '_' + request.auth.uid
        && (resource == null || resource.data.by == request.auth.uid)
        // after a supervisor hands in (sub = true) only the owner can reopen it
        && (resource == null || resource.data.get('sub', false) == false)
        && !dayClosed(request.resource.data.date);
    }
    // production parts (cut / fill layers by chainage): engineer records, owner and accountant view
    match /prod/{id} {
      allow read: if isMgr() || isEng();
      allow write: if isOwner() || isEng();
    }
    match /sealed/{d} {
      allow read: if isMgr();
      allow write: if isOwner();
    }
    match /requests/{id} {
      allow read: if isOwner() || (signedIn() && resource.data.by == request.auth.uid);
      allow create: if isMember() && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isOwner();
    }
  }
}
